---
const whatsappUrl =
  "https://wa.me/51949135876?text=Hola%2C%20Dr.%20Guzm%C3%A1n.%20Quisiera%20realizar%20una%20consulta%20sobre%20sus%20servicios%20legales.";
---

<section id="contacto" class="bg-[#efeee9] px-5 py-24 text-[#020d1d] md:px-8 md:py-32 lg:px-12 lg:py-40">
  <div class="mx-auto max-w-[1800px] pt-12 lg:pt-16">
    <div class="rule-reveal mb-12 h-px w-full origin-left bg-[#c99732]/55 lg:mb-16" aria-hidden="true"></div>
    <div class="scroll-reveal max-w-[760px] md:ml-[12rem] lg:ml-[18rem]">
      <h2 class="text-[0.68rem] font-medium uppercase tracking-[0.18em] text-[#c99732]">Contacto</h2>
      <p class="editorial-statement mt-8 text-[3rem] text-[#020d1d] md:text-[4.4rem] lg:text-[5rem]">
        ¿Necesitas orientación sobre tu caso?
      </p>
      <p class="mt-6 max-w-[600px] text-[1.05rem] leading-[1.75] text-[#020d1d]/70 md:text-[1.14rem]" data-reveal="body">
        Conversemos para revisar tu situación y evaluar las alternativas disponibles.
      </p>
      <p class="mt-5 max-w-[560px] border-l border-[#c99732]/60 pl-5 text-[0.94rem] leading-[1.65] text-[#020d1d]/62 md:text-[1rem]" data-reveal="body">
        Atención presencial en Arequipa y asesoría remota para Lima, previa coordinación.
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        class="mt-9 inline-flex border border-[#c99732] px-6 py-3 text-[0.78rem] font-medium uppercase tracking-[0.16em] text-[#020d1d] transition duration-300 hover:bg-[#c99732] hover:text-[#020d1d] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c99732] focus-visible:ring-offset-4 focus-visible:ring-offset-[#efeee9]"
        aria-label="Consultar por WhatsApp sobre servicios legales"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>
