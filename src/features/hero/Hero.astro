---
const footerLeft = {
  label: "ABOGADO",
  lines: ["Asesoría legal", "Defensa estratégica"],
} as const;

const footerRight = {
  label: "ATENCIÓN PERSONALIZADA",
  lines: ["Consultas y servicios"],
} as const;
---

<section
  class="animate-page-fade relative isolate flex min-h-[100svh] overflow-hidden bg-[#020d1d] px-5 text-[#efeee9] md:px-8 lg:px-12"
  aria-labelledby="hero-title"
>
  <h1 id="hero-title" class="sr-only">Saul Guzman — Abogado</h1>

  <div class="pointer-events-none absolute inset-x-0 top-[21vh] z-10 overflow-hidden md:top-[18vh] lg:top-[15vh]">
    <div class="animate-editorial-rise -ml-[10vw] md:ml-0" style="animation-delay: 500ms;">
      <div class="marquee-track flex w-max whitespace-nowrap">
        <span class="marquee-name pr-[18vw] text-[13vh] uppercase md:text-[18vh] lg:text-[24vh]">
          SAUL — GUZMAN
        </span>
        <span class="marquee-name pr-[18vw] text-[13vh] uppercase md:text-[18vh] lg:text-[24vh]">
          SAUL — GUZMAN
        </span>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-[54vh] z-20 px-[8vw] md:bottom-[28vh] md:top-auto md:px-8 lg:bottom-[25vh] lg:px-12">
    <div class="mx-auto max-w-[1800px]">
      <div class="reveal max-w-[56vw] md:max-w-[29rem]" style="animation-delay: 1050ms;">
        <p class="mb-4 text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem]">
          ABOGADO
        </p>
        <p class="editorial-statement text-[1.95rem] text-[#efeee9]/88 md:text-[2.4rem] lg:text-[2.75rem]">
          Asesoría legal para<br />
          personas y empresas
        </p>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 mx-auto flex h-[88svh] max-w-[1800px] items-end justify-end px-0 md:h-[92svh] md:justify-end lg:justify-end lg:px-[7vw]">
    <div class="relative -bottom-[1vh] -right-[14vw] h-auto w-[64vw] max-w-[330px] md:-bottom-[5vh] md:-right-[8vw] md:w-[58vw] md:max-w-[420px] lg:bottom-0 lg:right-0 lg:h-[86svh] lg:w-[min(40vw,44rem)] lg:max-w-none">
      <img
        class="animate-portrait-enter relative z-30 h-auto w-full object-contain object-bottom lg:absolute lg:bottom-0 lg:left-1/2 lg:h-full lg:w-auto lg:max-w-none lg:-translate-x-1/2"
        src="/images/abogado.png"
        alt="Retrato de Saul Guzman"
        width="760"
        height="1120"
        style="animation-delay: 300ms;"
      />
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-40 px-5 pb-6 md:px-8 md:pb-7 lg:z-20 lg:px-12 lg:pb-9">
    <div class="mx-auto max-w-[1800px]">
      <div class="animate-rule-draw h-px w-full origin-left bg-[#c99732]/70" style="animation-delay: 1200ms;"></div>

      <div class="mt-6 grid grid-cols-1 gap-4 text-[#efeee9] md:mt-7 md:grid-cols-2">
        <div class="reveal text-left" style="animation-delay: 1400ms;">
          <p class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem]">
            {footerLeft.label}
          </p>
          <div class="mt-3 text-[0.95rem] font-normal leading-[1.35] text-[#efeee9]/82 md:text-[1.06rem]">
            {
              footerLeft.lines.map((item) => (
                <p>{item}</p>
              ))
            }
          </div>
        </div>
        <div class="reveal hidden text-right md:block" style="animation-delay: 1550ms;">
          <p class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem]">
            {footerRight.label}
          </p>
          <div class="mt-3 text-[0.95rem] font-normal leading-[1.35] text-[#efeee9]/82 md:text-[1.06rem]">
            {
              footerRight.lines.map((item) => (
                <p>{item}</p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
