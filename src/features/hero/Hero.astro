---
const footerLeft = {
  label: "ABOGADO",
  lines: ["Asesoría legal", "Defensa estratégica"],
} as const;

const footerRight = {
  label: "ATENCIÓN PERSONALIZADA",
  lines: ["Consultas y servicios"],
} as const;
---

<section
  class="animate-page-fade relative isolate flex min-h-[100svh] overflow-hidden bg-[#020d1d] px-5 text-[#efeee9] md:px-8 lg:px-12"
  aria-labelledby="hero-title"
>
  <h1 id="hero-title" class="sr-only">Saul Guzman — Abogado</h1>

  <div class="pointer-events-none absolute inset-x-0 top-[17vh] z-10 overflow-hidden md:top-[16vh] lg:top-[15vh]">
    <div class="animate-editorial-rise" style="animation-delay: 500ms;">
      <div class="marquee-track flex w-max whitespace-nowrap">
        <span class="marquee-name pr-[18vw] text-[17vh] uppercase md:text-[22vh] lg:text-[24vh]">
          SAUL — GUZMAN
        </span>
        <span class="marquee-name pr-[18vw] text-[17vh] uppercase md:text-[22vh] lg:text-[24vh]">
          SAUL — GUZMAN
        </span>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-[24vh] z-20 px-5 md:bottom-[28vh] md:px-8 lg:bottom-[25vh] lg:px-12">
    <div class="mx-auto max-w-[1800px]">
      <div class="reveal max-w-[24rem] md:max-w-[29rem]" style="animation-delay: 1050ms;">
        <p class="mb-3 text-[0.68rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:mb-4">
          ABOGADO
        </p>
        <p class="editorial-statement text-[1.8rem] text-[#efeee9]/88 md:text-[2.4rem] lg:text-[2.75rem]">
          Asesoría legal estratégica<br />
          para personas y empresas
        </p>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 mx-auto flex h-[88svh] max-w-[1800px] items-end justify-center px-2 md:h-[92svh] md:justify-center lg:justify-end lg:px-[7vw]">
    <div class="relative h-[76svh] w-[min(92vw,34rem)] md:h-[82svh] md:w-[min(62vw,42rem)] lg:h-[86svh] lg:w-[min(40vw,44rem)]">
      <img
        class="animate-portrait-enter absolute bottom-0 left-1/2 z-30 h-full w-auto max-w-none -translate-x-1/2 object-contain object-bottom"
        src="/images/abogado.png"
        alt="Retrato de Saul Guzman"
        width="760"
        height="1120"
        style="animation-delay: 300ms;"
      />
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 px-5 pb-6 md:px-8 md:pb-7 lg:px-12 lg:pb-9">
    <div class="mx-auto max-w-[1800px]">
      <div class="animate-rule-draw h-px w-full origin-left bg-[#c99732]/70" style="animation-delay: 1200ms;"></div>

      <div class="mt-6 grid grid-cols-2 gap-4 text-[#efeee9] md:mt-7">
        <div class="reveal text-left" style="animation-delay: 1400ms;">
          <p class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem]">
            {footerLeft.label}
          </p>
          <div class="mt-3 text-[0.95rem] font-normal leading-[1.35] text-[#efeee9]/82 md:text-[1.06rem]">
            {
              footerLeft.lines.map((item) => (
                <p>{item}</p>
              ))
            }
          </div>
        </div>
        <div class="reveal text-right" style="animation-delay: 1550ms;">
          <p class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem]">
            {footerRight.label}
          </p>
          <div class="mt-3 text-[0.95rem] font-normal leading-[1.35] text-[#efeee9]/82 md:text-[1.06rem]">
            {
              footerRight.lines.map((item) => (
                <p>{item}</p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
