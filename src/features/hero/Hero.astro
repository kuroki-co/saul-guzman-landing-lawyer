---
import { Image } from "astro:assets";

const footerLeft = {
  label: "ÁREAS DE PRÁCTICA",
  lines: ["Protección al consumidor", "Marcas y Propiedad Intelectual", "Consumos Fraudulentos"],
} as const;

const footerRight = {
  label: "ATENCIÓN PERSONALIZADA",
  lines: ["Consultas y servicios"],
} as const;
---

<section
  class="animate-page-fade relative isolate flex min-h-[100svh] overflow-hidden bg-[#020d1d] px-5 text-[#efeee9] md:px-8 lg:px-12"
  aria-labelledby="hero-title"
>
  <h1 id="hero-title" class="sr-only">Wilfredo Saúl Guzmán Vásquez</h1>

  <div class="pointer-events-none absolute inset-x-0 top-[18vh] z-10 overflow-hidden md:top-[18vh] lg:top-[17vh]">
    <div class="animate-editorial-rise ml-0" style="animation-delay: 500ms;">
      <div class="marquee-track flex w-max whitespace-nowrap">
        <span class="marquee-name pr-[18vw] text-[11.5vh] uppercase md:text-[18vh] lg:text-[22.5vh]">
          SAUL — GUZMAN
        </span>
        <span class="marquee-name pr-[18vw] text-[11.5vh] uppercase md:text-[18vh] lg:text-[22.5vh]">
          SAUL — GUZMAN
        </span>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-[40.5svh] z-20 px-[7vw] min-[390px]:top-[42.5svh] md:bottom-[28vh] md:top-auto md:px-8 lg:bottom-[25vh] lg:px-12">
    <div class="mx-auto max-w-[1800px]">
      <div class="reveal max-w-[15.5rem] md:max-w-[29rem] lg:max-w-[34rem]" style="animation-delay: 1050ms;">
        <p class="mb-5 text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem] lg:mb-5">
          ABOGADO
        </p>
        <p class="editorial-statement text-[clamp(1.75rem,8.2vw,2.08rem)] text-[#efeee9]/88 md:text-[2.4rem] lg:text-[3.5rem] lg:leading-[1.06]">
          Asesoría legal para<br />
          consumidores, empresas y emprendedores.
        </p>
        <a
          href="#servicios"
          class="group pointer-events-auto mt-5 inline-flex w-fit items-center gap-2 text-[0.74rem] font-medium uppercase tracking-[0.07em] text-[#efeee9]/74 transition duration-300 hover:text-[#c99732] focus:outline-none focus-visible:text-[#c99732] md:hidden lg:mt-8 lg:inline-flex lg:text-[0.78rem] lg:tracking-[0.08em] lg:text-[#efeee9]/68"
        >
          <span>Ver áreas de práctica</span>
          <span class="transition duration-300 group-hover:translate-x-1.5" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-30 mx-auto flex h-[88svh] max-w-[1800px] items-end justify-end px-0 md:h-[92svh] md:justify-end lg:justify-end lg:px-[7vw]">
    <div class="relative bottom-0 -right-[14vw] h-auto w-[71vw] max-w-[355px] min-[390px]:-right-[10vw] min-[390px]:w-[73vw] min-[390px]:max-w-[380px] md:-bottom-[5vh] md:-right-[8vw] md:w-[58vw] md:max-w-[420px] lg:bottom-0 lg:right-[3vw] lg:h-[80svh] lg:w-[min(39.5vw,43rem)] lg:max-w-none">
      <Image
        class="animate-portrait-enter relative z-30 h-auto w-full object-contain object-bottom lg:absolute lg:bottom-0 lg:left-1/2 lg:h-full lg:w-auto lg:max-w-none lg:-translate-x-1/2"
        src="/images/abogado.png"
        alt="Retrato de Wilfredo Saúl Guzmán Vásquez"
        width="760"
        height="1120"
        style="animation-delay: 300ms;"
      />
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 px-5 pb-6 md:z-40 md:px-8 md:pb-7 lg:z-20 lg:px-12 lg:pb-9">
    <div class="mx-auto max-w-[1800px]">
      <div class="animate-rule-draw h-px w-full origin-left bg-[#c99732]/70" style="animation-delay: 1200ms;"></div>

      <div class="mt-6 grid grid-cols-1 gap-4 text-[#efeee9] md:mt-7 md:grid-cols-2">
        <div class="reveal hidden text-left md:block" style="animation-delay: 1400ms;">
          <p class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem]">
            {footerLeft.label}
          </p>
          <div class="mt-3 text-[0.95rem] font-normal leading-[1.35] text-[#efeee9]/82 md:text-[1.06rem]">
            {
              footerLeft.lines.map((item) => (
                <p>{item}</p>
              ))
            }
          </div>
        </div>
        <div class="reveal hidden text-right md:block" style="animation-delay: 1550ms;">
          <p class="text-[0.62rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78 md:text-[0.68rem] lg:text-[0.62rem] lg:text-[#c99732]/68">
            {footerRight.label}
          </p>
          <div class="mt-3 text-[0.95rem] font-normal leading-[1.35] text-[#efeee9]/82 md:text-[1.06rem] lg:text-[0.98rem] lg:text-[#efeee9]/66">
            {
              footerRight.lines.map((item) => (
                <p>{item}</p>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
