---
const whatsappUrl =
  "https://wa.me/51949135876?text=Hola%2C%20Dr.%20Guzm%C3%A1n.%20Quisiera%20realizar%20una%20consulta%20sobre%20sus%20servicios%20legales.";
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noreferrer"
  class="pointer-events-none fixed bottom-[18px] right-[18px] z-[90] flex h-11 w-11 translate-y-3 scale-[0.96] items-center justify-center rounded-full bg-[#25D366] text-white opacity-0 shadow-[0_8px_20px_rgba(0,0,0,0.18)] transition duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-[#020d1d] data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:scale-100 data-[visible=true]:opacity-100 md:bottom-7 md:right-7"
  aria-label="Contactar por WhatsApp"
  data-floating-whatsapp
  data-visible="false"
>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="h-5 w-5 fill-current">
    <path d="M16.02 4.4A11.49 11.49 0 0 0 6.2 21.84L4.8 27.6l5.9-1.35A11.5 11.5 0 1 0 16.02 4.4Zm0 2.1a9.4 9.4 0 0 1 7.98 14.36 9.39 9.39 0 0 1-11.98 3.23l-.4-.2-3.5.8.83-3.42-.24-.42A9.39 9.39 0 0 1 16.02 6.5Zm-3.28 4.8c-.2 0-.52.08-.8.38-.28.3-1.05 1.03-1.05 2.5 0 1.48 1.08 2.9 1.23 3.1.15.2 2.08 3.32 5.15 4.52 2.55 1 3.07.8 3.62.75.56-.05 1.8-.73 2.05-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35-.3-.15-1.8-.9-2.08-1-.28-.1-.48-.15-.68.15-.2.3-.78 1-.95 1.2-.18.2-.35.23-.65.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.14-.13.3-.35.45-.53.15-.17.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.68-1.65-.93-2.25-.24-.58-.5-.5-.68-.5h-.58Z" />
  </svg>
</a>

<script>
  const aboutSection = document.querySelector<HTMLElement>("#sobre-mi");
  const floatingWhatsApp = document.querySelector<HTMLElement>("[data-floating-whatsapp]");

  if (aboutSection && floatingWhatsApp) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        floatingWhatsApp.setAttribute("data-visible", String(entry.isIntersecting || entry.boundingClientRect.top < 0));
      },
      { threshold: 0.08 },
    );

    observer.observe(aboutSection);
  }
</script>
