---
import { Image } from "astro:assets";

const navItems = [
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Servicios", href: "#servicios" },
  { label: "Contacto", href: "#contacto" },
] as const;

const linkedinUrl = "https://www.linkedin.com/in/w-sa%C3%BAl-guzm%C3%A1n-v%C3%A1squez-a561981b7/";
const libroReclamacionesUrl = "/libro-de-reclamaciones";
---

<footer class="bg-[#010913] pb-8 pt-14 text-[#efeee9] md:pb-10 md:pt-18 lg:pt-20">
  <div class="mx-auto max-w-[1520px] px-5 md:px-8 lg:px-14">
    <div class="rule-reveal mb-10 h-px w-full origin-left bg-[#c99732]/60 md:mb-12" aria-hidden="true"></div>
    <div class="grid items-start gap-11 md:grid-cols-[2fr_0.82fr_1fr] md:gap-10 lg:grid-cols-[2fr_0.7fr_0.9fr_7rem] lg:gap-10">
      <div class="scroll-reveal">
        <Image src="/images/sg-logo.jpeg" alt="" width="640" height="640" class="h-16 w-auto" loading="lazy" />
        <p class="mt-6 max-w-[18rem] text-[1.1rem] leading-[1.35] text-[#efeee9]">Wilfredo Saúl Guzmán Vásquez</p>
        <p class="mt-2.5 text-[0.72rem] uppercase tracking-[0.13em] text-[#c99732]/78">Abogado</p>
      </div>

      <nav class="scroll-reveal" aria-label="Navegación de pie de página">
        <p class="text-[0.68rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78">Navegación</p>
        <ul class="mt-6 space-y-4 text-[0.95rem] text-[#efeee9]/72">
          {
            navItems.map((item) => (
              <li>
                <a class="transition duration-300 hover:text-[#c99732] focus:outline-none focus-visible:text-[#c99732] focus-visible:underline" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="scroll-reveal">
        <p class="text-[0.68rem] font-medium uppercase tracking-[0.18em] text-[#c99732]/78">Contacto</p>
        <ul class="mt-6 space-y-4 text-[0.95rem] text-[#efeee9]/72">
          <li>
            <a
              class="transition duration-300 hover:text-[#c99732] focus:outline-none focus-visible:text-[#c99732] focus-visible:underline"
              href="mailto:guzmanlegal337@gmail.com"
              aria-label="Enviar correo a guzmanlegal337@gmail.com"
            >
              guzmanlegal337@gmail.com
            </a>
          </li>
          <li>
            <a
              class="transition duration-300 hover:text-[#c99732] focus:outline-none focus-visible:text-[#c99732] focus-visible:underline"
              href="https://wa.me/51949135876"
              target="_blank"
              rel="noreferrer"
              aria-label="Contactar por WhatsApp al +51 949 135 876, abre en una nueva pestaña"
            >
              +51 949 135 876
            </a>
          </li>
          <li>
            <a
              class="transition duration-300 hover:text-[#c99732] focus:outline-none focus-visible:text-[#c99732] focus-visible:underline"
              href={linkedinUrl}
              target="_blank"
              rel="noreferrer"
              aria-label="Ver perfil de LinkedIn de Wilfredo Saúl Guzmán Vásquez, abre en una nueva pestaña"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

      <div class="scroll-reveal md:col-start-3 lg:col-start-auto lg:justify-self-start">
        <a
          href={libroReclamacionesUrl}
          class="group flex w-fit flex-col gap-3 transition duration-300 hover:-translate-y-0.5 hover:opacity-88 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#c99732] focus-visible:ring-offset-4 focus-visible:ring-offset-[#010913]"
          aria-label="Abrir Libro de Reclamaciones"
        >
          <span class="text-[0.68rem] font-medium uppercase leading-none tracking-[0.18em] text-[#c99732]/78">
            Atención al Consumidor
          </span>
          <Image
            src="/images/libro-reclamaciones.webp"
            alt="Libro de Reclamaciones"
            width="1100"
            height="930"
            class="h-auto w-[72px] rounded-[2px] lg:w-[88px]"
            loading="lazy"
          />
        </a>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-[#efeee9]/14 pt-6 text-[0.72rem] text-[#efeee9]/48 md:mt-14 md:flex-row md:items-center md:justify-between md:pt-7">
      <p>© 2026 Wilfredo Saúl Guzmán Vásquez</p>
      <p class="md:pr-16 lg:pr-20">Todos los derechos reservados</p>
    </div>
  </div>
</footer>
