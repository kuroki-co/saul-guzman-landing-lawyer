---
const biography = [
  "Wilfredo Saúl Guzmán Vásquez brinda asesoría legal enfocada en la protección de los derechos de consumidores y empresas, con especial atención a conflictos de consumo, protección de marcas y propiedad intelectual, así como operaciones o consumos fraudulentos.",
  "Su enfoque combina análisis jurídico, estrategia y atención personalizada, buscando ofrecer soluciones claras y prácticas para cada caso.",
] as const;
---

<section id="sobre-mi" class="relative overflow-hidden bg-[#efeee9] px-5 py-24 text-[#020d1d] md:px-8 md:py-32 lg:px-12 lg:py-40">
  <div class="relative mx-auto grid max-w-[1800px] gap-16 border-t border-[#c99732]/55 pt-12 md:min-h-[68vh] md:grid-cols-[minmax(18rem,0.9fr)_minmax(0,1fr)] md:items-center md:gap-16 md:pt-20 lg:min-h-[70vh] lg:gap-24 lg:pt-24">
    <div class="scroll-reveal">
      <div>
        <p class="text-[0.68rem] font-medium uppercase tracking-[0.18em] text-[#c99732]">01</p>
        <h2 class="mt-3 text-[0.72rem] font-medium uppercase tracking-[0.18em] text-[#020d1d]/58">Sobre mí</h2>
      </div>

      <p class="editorial-statement mt-12 text-[3.1rem] text-[#020d1d] md:mt-14 md:text-[4.6rem] lg:mt-16 lg:text-[5.4rem]">
        Wilfredo Saúl<br />
        Guzmán Vásquez
      </p>
    </div>

    <div class="max-w-[680px] md:pt-16 lg:pt-20">
      <p class="scroll-reveal text-[1.12rem] leading-[1.6] text-[#020d1d]/82 md:text-[1.28rem]" data-reveal="body">
        Abogado especializado en protección al consumidor, marcas, propiedad intelectual y operaciones de consumo fraudulentas.
      </p>

      <div class="scroll-reveal mt-10 grid gap-6 border-l border-[#c99732]/60 pl-6 text-[1rem] leading-[1.75] text-[#020d1d]/70 md:mt-12 md:gap-7 md:pl-8 md:text-[1.06rem]" data-reveal="body">
        {
          biography.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>
